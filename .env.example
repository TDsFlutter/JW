# Firebase Storefront Configuration - ëlla Jewelry
# Copy this file to `.env.local` and substitute with your actual Firebase project settings.
# When deploying to Vercel, set these in the Vercel Dashboard > Project > Settings > Environment Variables.

NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Panel URL (set to your Vercel admin panel deployment URL in production)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# MongoDB — website reads products/categories directly from the database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB=ella_jewelry

# Google Reviews Integration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACE_ID=your_google_place_id
CRON_SECRET=your_random_cron_secret
